---
// <-------------------DADOS RECEBIDOS------------------->
// O import de tipo orienta o editor; ele não envia código ao navegador.
import type { Membro } from '../data/membros';

interface Props {
  // O cartão exibe o perfil; a classificação em grupos é responsabilidade da página.
  membro: Omit<Membro, 'grupo'>;
  // Humanos estão abaixo de uma subseção (h3); não humanos ficam direto na seção (h2).
  nivelTitulo?: 'h3' | 'h4';
}

const { membro, nivelTitulo = 'h4' } = Astro.props;
const Titulo = nivelTitulo;
const TituloInteresses = nivelTitulo === 'h3' ? 'h4' : 'h5';
const temContatos = membro.lattes || membro.github || membro.site || membro.email;
const tituloId = `membro-${membro.id}`;
---

<!-- CARTÃO DE MEMBRO -->
<article class="cartao-membro" aria-labelledby={tituloId}>
  <!-- O recorte é apenas visual: o arquivo original permanece intacto. -->
  <img
    class="foto"
    src={membro.foto}
    style={{ objectPosition: membro.posicaoFoto }}
    alt={`Foto de ${membro.nome}`}
    width="400"
    height="400"
    loading="lazy"
    decoding="async"
  />

  <div class="informacoes">
    <Titulo class="nome-membro" id={tituloId}>{membro.nome}</Titulo>

    <!-- INTERESSES DE PESQUISA -->
    <TituloInteresses class="titulo-interesses">Interesses de pesquisa</TituloInteresses>
    <ul class="interesses">
      {membro.interesses.map((interesse) => <li>{interesse}</li>)}
    </ul>

    <!-- LINKS ACADÊMICOS E CONTATO -->
    <!-- Campos opcionais só produzem links quando estão preenchidos. -->
    {temContatos && (
      <div class="contatos">
        {membro.lattes && <a href={membro.lattes}>Lattes</a>}
        {membro.github && <a href={membro.github}>GitHub</a>}
        {membro.site && <a href={membro.site}>Site pessoal</a>}
        {membro.email && (
          <a class="email" href={`mailto:${membro.email}`}>
            <span>E-mail institucional</span>
            {membro.email}
          </a>
      )}
    </div>
    )}
  </div>
</article>

<style>
  /* <-------------------ESTRUTURA DO CARTÃO-------------------> */
  .cartao-membro {
    min-width: 0;
    border: 1px solid var(--borda);
    border-radius: 12px;
    background-color: var(--superficie-suave);
    transition: box-shadow 180ms ease, border-color 180ms ease;
  }

  /* O formato quadrado padroniza as fotos sem deformá-las. */
  .foto {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center 30%;
    border-radius: 11px 11px 0 0;
  }

  .informacoes { padding: 24px; }

  /* <-------------------TEXTOS E INTERESSES-------------------> */
  .nome-membro { margin: 0 0 24px; color: var(--texto-titulo); font-size: 1.5rem; }
  .titulo-interesses { margin: 0 0 12px; font-size: 1rem; }
  .interesses { margin: 0 0 24px; padding-left: 20px; }
  .interesses li + li { margin-top: 4px; }

  /* <-------------------CONTATOS-------------------> */
  .contatos { display: flex; flex-wrap: wrap; gap: 12px 20px; }
  .contatos a { padding-block: 6px; }
  .email { flex-basis: 100%; overflow-wrap: anywhere; font-size: 0.9rem; }
  .email span { display: block; }

  /* <-------------------DESTAQUE E ACESSIBILIDADE-------------------> */
  /* O conteúdo permanece visível em mouse, teclado e telas de toque. */
  .cartao-membro:focus-within {
    border-color: var(--azul);
    box-shadow: 0 8px 24px var(--sombra-cartao);
  }

  /* Aplica hover apenas em dispositivos que realmente suportam esse gesto. */
  @media (hover: hover) and (pointer: fine) {
    .cartao-membro:hover {
      border-color: var(--azul);
      box-shadow: 0 8px 24px var(--sombra-cartao);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cartao-membro { transition: none; }
  }
</style>
