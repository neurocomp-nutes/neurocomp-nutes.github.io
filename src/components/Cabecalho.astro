---
const links = [
  { href: '#inicio', texto: 'Início' },
  { href: '#sobre', texto: 'Sobre' },
  { href: '#noticias', texto: 'Notícias' },
  { href: '#pesquisa', texto: 'Pesquisa' },
  { href: '#publicacoes', texto: 'Publicações' },
  { href: '#equipe', texto: 'Equipe' },
  { href: '#contato', texto: 'Contato' },
];
---

<header class="cabecalho">
  <div class="faixa-marcas">
    <div class="marcas-interno">
      <a class="marca-neurocomp" href="#inicio" aria-label="NeuroComp, início">
        <img
          src="/imgs/logos/oficial_brain_no_background.png"
          alt=""
          width="120"
          height="80"
        />
        <span>
          <strong>NeuroComp</strong>
          <small>Neurociência Computacional</small>
        </span>
      </a>

      <div class="instituicoes" aria-label="Instituições: NUTES e Universidade Estadual da Paraíba">
        <div class="marcas-institucionais">
          <img src="/imgs/logos/nutes_logo.png" alt="NUTES" width="170" height="72" />
          <span class="divisor-marcas" aria-hidden="true"></span>
          <span class="marca-uepb" role="img" aria-label="Universidade Estadual da Paraíba"></span>
        </div>
      </div>
    </div>
  </div>

  <div class="faixa-navegacao">
    <div class="navegacao-interna">
      <details class="menu" open>
        <summary aria-label="Menu principal">
          <span class="icone-menu" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="rotulo-menu">Menu</span>
        </summary>
        <nav aria-label="Navegação principal">
          <ul>
            {links.map((link) => (
              <li><a href={link.href}>{link.texto}</a></li>
            ))}
          </ul>
        </nav>
      </details>
      <div class="seletor-tema">
        <button
          class="alternar-tema"
          type="button"
          aria-label="Escolher tema"
          aria-expanded="false"
          aria-controls="opcoes-tema"
          title="Escolher tema"
        >
          <svg class="icone-tema ideia" viewBox="0 0 44 40" aria-hidden="true" focusable="false">
            <path d="M19 8c-2-3-6-3-9-1-3 2-3 5-2 8-3 2-4 6-1 9-1 4 2 7 6 7 1 4 5 5 8 3V9m0 0c2-3 6-4 9-2 3 2 3 5 2 8 3 2 4 6 1 9 1 4-2 7-6 7-1 4-5 5-8 3"></path>
            <path d="M13 13c2 1 2 4 0 5m12-8v22m5-17c-2 1-2 4 0 5m-14 3c2 0 3 2 2 4m12-4c-2 0-3 2-2 4"></path>
            <circle cx="36" cy="7" r="3"></circle>
            <path d="M36 1v2m6 4h-2m-8 0h-2m8 4h-4"></path>
          </svg>
          <svg class="icone-tema sono" viewBox="0 0 44 40" aria-hidden="true" focusable="false">
            <path d="M19 8c-2-3-6-3-9-1-3 2-3 5-2 8-3 2-4 6-1 9-1 4 2 7 6 7 1 4 5 5 8 3V9m0 0c2-3 6-4 9-2 3 2 3 5 2 8 3 2 4 6 1 9 1 4-2 7-6 7-1 4-5 5-8 3"></path>
            <path d="M13 13c2 1 2 4 0 5m12-8v22m5-17c-2 1-2 4 0 5m-14 3c2 0 3 2 2 4m12-4c-2 0-3 2-2 4"></path>
            <path d="M32 5h8l-8 6h8m-7 4h6l-6 5h6"></path>
          </svg>
          <svg class="icone-tema atividade" viewBox="0 0 44 40" aria-hidden="true" focusable="false">
            <path d="M19 8c-2-3-6-3-9-1-3 2-3 5-2 8-3 2-4 6-1 9-1 4 2 7 6 7 1 4 5 5 8 3V9m0 0c2-3 6-4 9-2 3 2 3 5 2 8 3 2 4 6 1 9 1 4-2 7-6 7-1 4-5 5-8 3"></path>
            <path d="M13 13c2 1 2 4 0 5m12-8v22m5-17c-2 1-2 4 0 5m-14 3c2 0 3 2 2 4m12-4c-2 0-3 2-2 4"></path>
            <path d="m36 3 1.4 3.6L41 8l-3.6 1.4L36 13l-1.4-3.6L31 8l3.6-1.4L36 3Z"></path>
          </svg>
        </button>
        <div class="opcoes-tema" id="opcoes-tema" role="group" aria-label="Opções de tema" hidden>
          <button type="button" data-theme-choice="light" aria-pressed="false"><span class="amostra-tema claro"></span>Claro</button>
          <button type="button" data-theme-choice="gray" aria-pressed="false"><span class="amostra-tema cinza"></span>Cinza</button>
          <button type="button" data-theme-choice="blue" aria-pressed="false"><span class="amostra-tema azul"></span>Azul</button>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const mobileMenu = window.matchMedia('(max-width: 760px)');

  document.querySelectorAll<HTMLDetailsElement>('.menu').forEach((menu) => {
    menu.open = !mobileMenu.matches;
    mobileMenu.addEventListener('change', () => {
      menu.open = !mobileMenu.matches;
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (mobileMenu.matches) menu.open = false;
      });
    });
  });

  const themeToggle = document.querySelector<HTMLButtonElement>('.alternar-tema');
  const themeOptions = document.querySelector<HTMLDivElement>('.opcoes-tema');
  const themeChoices = document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]');
  const syncThemePicker = () => {
    const theme = document.documentElement.dataset.theme ?? 'light';
    themeToggle?.classList.toggle('tema-cinza', theme === 'gray');
    themeToggle?.classList.toggle('tema-azul', theme === 'blue');
    themeChoices.forEach((choice) => {
      choice.setAttribute('aria-pressed', String(choice.dataset.themeChoice === theme));
    });
  };

  const closeThemeOptions = (restoreFocus = false) => {
    if (!themeOptions || themeOptions.hidden) return;
    themeOptions.hidden = true;
    themeToggle?.setAttribute('aria-expanded', 'false');
    if (restoreFocus) themeToggle?.focus();
  };

  syncThemePicker();
  themeToggle?.addEventListener('click', () => {
    const isOpen = themeToggle.getAttribute('aria-expanded') === 'true';
    themeOptions!.hidden = isOpen;
    themeToggle.setAttribute('aria-expanded', String(!isOpen));
  });
  themeChoices.forEach((choice) => {
    choice.addEventListener('click', () => {
      const nextTheme = choice.dataset.themeChoice;
      if (nextTheme !== 'light' && nextTheme !== 'gray' && nextTheme !== 'blue') return;

      document.documentElement.dataset.theme = nextTheme;
      syncThemePicker();
      closeThemeOptions();
      themeToggle?.focus();
      try {
        localStorage.setItem('neurocomp-theme', nextTheme);
      } catch (error) {
        console.error('Não foi possível salvar a preferência de tema.', error);
      }
    });
  });
  document.addEventListener('pointerdown', (event) => {
    if (event.target instanceof Node && !event.target.closest('.seletor-tema')) {
      closeThemeOptions();
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeThemeOptions(true);
  });
</script>

<style>
  .cabecalho { position: relative; z-index: 5; }
  .faixa-marcas { background: var(--faixa-marca); }
  .marcas-interno {
    display: flex;
    max-width: 1160px;
    min-height: 142px;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    margin-inline: auto;
    padding: 20px 24px;
  }
  .marca-neurocomp {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 16px;
    color: var(--texto-titulo);
    text-decoration: none;
  }
  .marca-neurocomp img { width: 96px; height: 76px; object-fit: contain; }
  .marca-neurocomp strong { display: block; font-size: clamp(1.6rem, 3vw, 2.2rem); line-height: 1.1; }
  .marca-neurocomp small { display: block; margin-top: 6px; color: var(--texto-secundario); font-size: 0.78rem; letter-spacing: 0.08em; }
  .instituicoes { display: flex; flex: 0 0 auto; align-items: center; }
  .marcas-institucionais {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }
  .marcas-institucionais img { width: 144px; height: 54px; object-fit: contain; }
  .marcas-institucionais .marca-uepb {
    width: 54px;
    height: 54px;
    background-color: var(--texto-titulo);
    -webkit-mask: url('/imgs/logos/uepb.png') center / contain no-repeat;
    mask: url('/imgs/logos/uepb.png') center / contain no-repeat;
  }
  .divisor-marcas {
    width: 2px;
    height: 40px;
    border-radius: 2px;
    background: var(--texto-titulo);
  }
  .faixa-navegacao { background: var(--faixa-navegacao); }
  .navegacao-interna { position: relative; max-width: 1160px; margin-inline: auto; padding-inline: 24px; }
  .menu { position: relative; }
  .menu > summary { display: none; }
  .menu:not([open]) > nav { display: block; }
  .menu ul { display: flex; justify-content: center; gap: 4px; margin: 0; padding: 0; list-style: none; }
  .menu a {
    position: relative;
    display: block;
    padding: 17px 16px;
    color: #fff;
    font-size: 0.94rem;
    font-weight: 700;
    text-decoration: none;
    transition: color 180ms ease;
  }
  .menu a::after {
    position: absolute;
    right: 16px;
    bottom: 10px;
    left: 16px;
    height: 2px;
    background: var(--menu-indicador);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms ease;
  }
  .menu a:hover {
    color: var(--menu-hover);
  }
  .menu a:hover::after,
  .menu a:focus-visible::after {
    transform: scaleX(1);
  }
  .menu a:focus-visible, .menu > summary:focus-visible { outline-color: #fff; }
  .seletor-tema {
    position: absolute;
    top: 50%;
    right: 24px;
    z-index: 2;
    transform: translateY(-50%);
  }
  .alternar-tema {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 35%);
    border-radius: 50%;
    background: transparent;
    color: #fff;
    cursor: pointer;
    transition: background-color 160ms ease, border-color 160ms ease;
  }
  .alternar-tema:hover {
    border-color: rgb(255 255 255 / 75%);
    background: rgb(255 255 255 / 12%);
  }
  .alternar-tema:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  .icone-tema { width: 30px; height: 30px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
  .icone-tema.sono, .icone-tema.atividade { display: none; }
  :global(html[data-theme='gray']) .icone-tema.ideia,
  :global(html[data-theme='blue']) .icone-tema.ideia { display: none; }
  :global(html[data-theme='gray']) .icone-tema.sono { display: block; }
  :global(html[data-theme='blue']) .icone-tema.atividade { display: block; }
  :global(html[data-theme='gray']) .marcas-institucionais img:first-child,
  :global(html[data-theme='blue']) .marcas-institucionais img:first-child {
    padding: 4px;
    border-radius: 4px;
    background: #fff;
  }
  .opcoes-tema {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    display: grid;
    min-width: 150px;
    gap: 4px;
    padding: 8px;
    border: 1px solid var(--borda);
    border-radius: 12px;
    background: var(--superficie);
    box-shadow: 0 10px 28px rgb(0 0 0 / 20%);
  }
  .opcoes-tema[hidden] { display: none; }
  .opcoes-tema button {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 40px;
    padding: 8px 10px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--texto);
    font: inherit;
    font-size: 0.9rem;
    text-align: left;
    cursor: pointer;
  }
  .opcoes-tema button:hover,
  .opcoes-tema button[aria-pressed='true'] {
    background: var(--superficie-suave);
  }
  .opcoes-tema button[aria-pressed='true'] { font-weight: 700; }
  .opcoes-tema button:focus-visible { outline: 2px solid var(--foco); outline-offset: 1px; }
  .amostra-tema { width: 16px; height: 16px; border: 1px solid var(--borda); border-radius: 50%; }
  .amostra-tema.claro { background: linear-gradient(135deg, #fff 50%, #edf4fa 50%); }
  .amostra-tema.cinza { background: linear-gradient(135deg, #252421 50%, #3b3833 50%); }
  .amostra-tema.azul { background: linear-gradient(135deg, #172635 50%, #284e70 50%); }

  @media (max-width: 760px) {
    .marcas-interno { min-height: 120px; gap: 20px; padding: 16px 20px; }
    .marca-neurocomp { gap: 10px; }
    .marca-neurocomp img { width: 72px; height: 64px; }
    .marca-neurocomp small { max-width: 190px; font-size: 0.68rem; }
    .marcas-institucionais { gap: 12px; }
    .marcas-institucionais img { width: 118px; height: 46px; }
    .marcas-institucionais .marca-uepb { width: 46px; height: 46px; }
    .divisor-marcas { height: 36px; }
    .navegacao-interna { padding: 0; }
    .seletor-tema { top: 10px; right: 12px; transform: none; }
    .menu > summary {
      display: flex;
      min-height: 64px;
      align-items: center;
      justify-content: center;
      gap: 12px;
      color: #fff;
      font-weight: 700;
      cursor: pointer;
      list-style: none;
    }
    .menu > summary::-webkit-details-marker { display: none; }
    .menu:not([open]) > nav { display: none; }
    .icone-menu { display: grid; width: 25px; gap: 5px; }
    .icone-menu span { height: 3px; border-radius: 3px; background: currentColor; transition: transform 160ms ease, opacity 160ms ease; }
    .menu[open] .icone-menu span:first-child { transform: translateY(8px) rotate(45deg); }
    .menu[open] .icone-menu span:nth-child(2) { opacity: 0; }
    .menu[open] .icone-menu span:last-child { transform: translateY(-8px) rotate(-45deg); }
    .menu nav { padding: 0 20px 16px; }
    .menu ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px; }
    .menu a { padding: 13px 14px; text-align: center; }
    .menu a::after { right: 14px; bottom: 7px; left: 14px; }
  }

  @media (max-width: 480px) {
    .marcas-interno { flex-direction: column; align-items: flex-start; gap: 12px; padding-block: 14px; }
    .marca-neurocomp { width: 100%; }
    .instituicoes { align-self: flex-end; }
    .marcas-institucionais { gap: 10px; }
    .marcas-institucionais img { width: 104px; height: 42px; }
    .marcas-institucionais .marca-uepb { width: 42px; height: 42px; }
    .divisor-marcas { height: 32px; }
    .menu ul { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu a, .menu a::after, .icone-menu span, .alternar-tema { transition: none; }
  }
</style>
