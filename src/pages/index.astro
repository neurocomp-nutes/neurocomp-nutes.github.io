---
// <-------------------COMPONENTES DA PÁGINA------------------->
// O layout cuida da estrutura HTML; esta página organiza o conteúdo.
import LayoutPrincipal from '../layouts/LayoutPrincipal.astro';
import Secao from '../components/Secao.astro';
import CartaoMembro from '../components/CartaoMembro.astro';
import { membros } from '../data/membros';
---

<LayoutPrincipal>
  <!-- APRESENTAÇÃO DO NEUROCOMP -->
  <section id="inicio" aria-labelledby="titulo-inicio" class="apresentacao">
    <div>
      <p class="etiqueta">Neurociência Computacional · NUTES | UEPB</p>
      <h1 id="titulo-inicio">NeuroComp</h1>
      <p>Grupo de Pesquisa em Neurociência Computacional afiliado ao NUTES | UEPB.</p>
      <div class="acoes">
        <a class="botao" href="#pesquisa">Conheça nossas pesquisas</a>
        <a class="botao" href="#equipe">Nossa equipe</a>
      </div>
    </div>
    <!-- Logo oficial -->
    <img src="/imgs/oficial_brain_no_background.png" alt="Símbolo do NeuroComp" width="1536" height="1024" fetchpriority="high" />
  </section>

  <!-- NOTÍCIAS EM DESTAQUE -->
  <Secao id="noticias" titulo="Notícias do laboratório" etiqueta="Acompanhe o NeuroComp">
    <!-- Substituir o aviso por notícias reais com título, data e imagem. -->
    <div class="pendente"><p>Em breve: notícias, eventos e novidades do NeuroComp.</p></div>
  </Secao>

  <!-- SOBRE E LOCALIZAÇÃO -->
  <Secao id="sobre" titulo="Sobre o NeuroComp" etiqueta="Nosso grupo">
    <p>Somos um grupo de pesquisa em Neurociência Computacional afiliado ao NUTES, na Universidade Estadual da Paraíba (UEPB).</p>
    <!-- A descrição dos objetivos e o endereço devem ser aprovados pelo grupo. -->
    <div class="pendente"><p>Apresentação detalhada e informações de localização em preparação.</p></div>
  </Secao>

  <!-- LINHAS DE PESQUISA E PROJETOS -->
  <Secao id="pesquisa" titulo="Linhas de pesquisa e projetos" etiqueta="O que investigamos">
    <div class="pendente"><p>Estamos preparando a apresentação das linhas de pesquisa e dos projetos do grupo.</p></div>
    <p class="link-projetos"><a href="https://github.com/neurocomp-nutes">Conheça nossos projetos no GitHub →</a></p>
  </Secao>

  <!-- PUBLICAÇÕES -->
  <Secao id="publicacoes" titulo="Produção científica" etiqueta="Artigos e trabalhos">
    <!-- Cada trabalho terá autores, ano, link e situação editorial explícita. -->
    <div class="pendente"><p>A lista de trabalhos será disponibilizada com identificação de artigos submetidos, preprints, aceitos e publicados.</p></div>
  </Secao>

  <!-- EQUIPE ATUAL -->
  <Secao id="equipe" titulo="Quem faz o NeuroComp" etiqueta="Equipe">
    <!-- Adicionar cartões apenas quando nomes, categorias e fotos forem fornecidos. -->
    <div class="grade-membros">
      {membros.map((membro) => <CartaoMembro membro={membro} />)}
    </div>
  </Secao>

  <!-- ALUMNI E MEMBROS NÃO HUMANOS -->
  <div class="grade">
    <Secao id="alumni" titulo="Alumni" etiqueta="Nossa trajetória">
      <p>Espaço dedicado a quem já fez parte do NeuroComp.</p>
      <div class="pendente"><p>Lista de antigos membros em preparação.</p></div>
    </Secao>
    <Secao id="nao-humanos" titulo="Membros não humanos" etiqueta="Além da pesquisa">
      <!-- O requisito informa o nome Marlboro; aguardamos foto e descrição. -->
      <h3>Marlboro</h3>
      <div class="pendente"><p>Foto e apresentação em breve.</p></div>
    </Secao>
  </div>
</LayoutPrincipal>


<style>
  /* <-------------------GRADE DA EQUIPE-------------------> */
  /* auto-fill reserva colunas para novos membros sem esticar um único cartão. */
  .grade-membros {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 24px;
    align-items: start;
  }

  /* <-------------------APRESENTAÇÃO-------------------> */
  .apresentacao { display: grid; grid-template-columns: 1.2fr 1fr; align-items: center; gap: 32px; background: #edf4fa; }
  .apresentacao h1 { font-size: clamp(2.5rem, 7vw, 4.5rem); letter-spacing: -0.04em; }
  .apresentacao img { width: 100%; }
  .link-projetos { margin-top: 24px; margin-bottom: 0; }
  /* <-------------------TELAS PEQUENAS-------------------> */
  @media (max-width: 700px) {
    .apresentacao { grid-template-columns: 1fr; }
    .apresentacao img { max-width: 280px; justify-self: center; }
  }
</style>
