---
// <-------------------COMPONENTES DA PÁGINA------------------->
// O layout cuida da estrutura HTML; esta página organiza o conteúdo.
import LayoutPrincipal from '../layouts/LayoutPrincipal.astro';
import Secao from '../components/Secao.astro';
import CartaoMembro from '../components/CartaoMembro.astro';
import { membros, gruposEquipe } from '../data/membros';

// <-------------------AGRUPAMENTO DA EQUIPE------------------->
// O agrupamento acontece no build, sem JavaScript adicional no navegador.
const gruposMembros = gruposEquipe
  .map((grupo) => ({
    ...grupo,
    pessoas: membros.filter((membro) => membro.grupo === grupo.id),
  }))
  .filter((grupo) => grupo.pessoas.length > 0);

const destaquesNoticias = [
  {
    imagem: '/imgs/noticias/neurociencia.svg',
    alt: 'Ilustração abstrata de neurônios conectados',
    categoria: 'Neurociência',
    titulo: 'Ideias que conectam ciência e tecnologia',
    descricao: 'Acompanhe por aqui as novidades, atividades e descobertas do NeuroComp.',
  },
  {
    imagem: '/imgs/noticias/pesquisa.svg',
    alt: 'Ilustração abstrata de dados e sinais científicos',
    categoria: 'Pesquisa',
    titulo: 'Pesquisa em movimento',
    descricao: 'Em breve, este espaço reunirá atualizações sobre os estudos do grupo.',
  },
  {
    imagem: '/imgs/noticias/conexoes.svg',
    alt: 'Ilustração abstrata de pessoas e conexões em rede',
    categoria: 'Comunidade',
    titulo: 'Ciência feita em colaboração',
    descricao: 'Novidades sobre eventos e a comunidade do laboratório serão publicadas aqui.',
  },
];

const noticias = [
  {
    imagem: '/imgs/noticias/neurociencia.svg',
    alt: 'Ilustração abstrata de neurônios conectados',
    categoria: 'Neurociência',
    titulo: 'Novidades do laboratório',
    descricao: 'Estamos preparando atualizações sobre as atividades e iniciativas do NeuroComp.',
  },
  {
    imagem: '/imgs/noticias/pesquisa.svg',
    alt: 'Ilustração abstrata de dados e sinais científicos',
    categoria: 'Pesquisa',
    titulo: 'Pesquisas em destaque',
    descricao: 'Em breve, compartilharemos notícias sobre pesquisas e produção científica do grupo.',
  },
  {
    imagem: '/imgs/noticias/conexoes.svg',
    alt: 'Ilustração abstrata de pessoas e conexões em rede',
    categoria: 'Eventos',
    titulo: 'Eventos e encontros',
    descricao: 'Acompanhe este espaço para conhecer eventos e atividades do laboratório.',
  },
  {
    imagem: '/imgs/noticias/pesquisa.svg',
    alt: 'Ilustração abstrata de dados e sinais científicos',
    categoria: 'Comunidade',
    titulo: 'Ciência em colaboração',
    descricao: 'Em breve, novidades sobre a comunidade e as parcerias do NeuroComp.',
  },
];
---

<LayoutPrincipal>
  <!-- APRESENTAÇÃO DO NEUROCOMP -->
  <section
    id="inicio"
    aria-labelledby="titulo-inicio"
    class="apresentacao"
  >
    <div class="conteudo-capa">
      <!-- Logo oficial -->
      <img
        class="logo-capa"
        src="/imgs/logos/oficial_brain_no_background.png"
        alt="Símbolo do NeuroComp"
        width="1536"
        height="1024"
      />


      <h1 id="titulo-inicio">NeuroComp</h1>

      <p class="descricao-capa">
        Grupo de Pesquisa em Neurociência Computacional
        afiliado ao NUTES | UEPB.
      </p>

      <div class="acoes">
        <a class="botao" href="#pesquisa">Conheça nossas pesquisas</a>
        <a class="botao" href="#equipe">Nossa equipe</a>
      </div>
    </div>
  </section>

  <!-- NOTÍCIAS EM DESTAQUE -->
  <Secao id="noticias" titulo="Notícias do laboratório" etiqueta="Acompanhe o NeuroComp">
    <div class="destaques">
      <div class="cabecalho-carrossel">
        <div>
          <p class="etiqueta">Em destaque</p>
          <h3 class="titulo-carrossel">Ciência em movimento</h3>
        </div>
        <div class="controles" aria-label="Navegação dos destaques">
          <button class="controle" type="button" data-carousel-control="destaques" data-carousel-direction="-1" aria-label="Destaque anterior">←</button>
          <button class="controle" type="button" data-carousel-control="destaques" data-carousel-direction="1" aria-label="Próximo destaque">→</button>
        </div>
      </div>

      <div class="viewport viewport-destaques" data-carousel-viewport="destaques" aria-label="Imagens em destaque" tabindex="0">
        {destaquesNoticias.map((destaque) => (
          <article class="slide-destaque">
            <img src={destaque.imagem} alt={destaque.alt} width="720" height="480" />
            <div class="texto-destaque">
              <span class="categoria">{destaque.categoria}</span>
              <h4>{destaque.titulo}</h4>
              <p>{destaque.descricao}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="indicadores" aria-label="Selecionar destaque">
        {destaquesNoticias.map((destaque, indice) => (
          <button
            type="button"
            class="indicador"
            data-carousel-slide={indice}
            data-carousel-indicator="destaques"
            aria-label={`Ir para o destaque ${indice + 1}: ${destaque.categoria}`}
            aria-current={indice === 0 ? 'true' : undefined}
          ></button>
        ))}
      </div>
    </div>

    <div class="cabecalho-carrossel cabecalho-noticias">
      <div>
        <p class="etiqueta">Fique por dentro</p>
        <h3 class="titulo-carrossel">Últimas notícias</h3>
      </div>
      <div class="controles" aria-label="Navegação das notícias">
        <button class="controle" type="button" data-carousel-control="noticias" data-carousel-direction="-1" aria-label="Notícia anterior">←</button>
        <button class="controle" type="button" data-carousel-control="noticias" data-carousel-direction="1" aria-label="Próxima notícia">→</button>
      </div>
    </div>
    <div class="viewport viewport-noticias" data-carousel-viewport="noticias" aria-label="Notícias do NeuroComp" tabindex="0">
      {noticias.map((noticia) => (
        <article class="cartao-noticia">
          <img src={noticia.imagem} alt={noticia.alt} width="480" height="300" loading="lazy" />
          <div class="corpo-noticia">
            <span class="categoria">{noticia.categoria}</span>
            <h4>{noticia.titulo}</h4>
            <p>{noticia.descricao}</p>
            <span class="em-breve">Em breve</span>
          </div>
        </article>
      ))}
    </div>
  </Secao>

  <!-- SOBRE E LOCALIZAÇÃO -->
  <Secao id="sobre" titulo="Sobre o NeuroComp" etiqueta="Nosso grupo">
    <p>Somos um grupo de pesquisa em Neurociência Computacional afiliado ao NUTES, na Universidade Estadual da Paraíba (UEPB).</p>
    <!-- A descrição dos objetivos e o endereço devem ser aprovados pelo grupo. -->
    <div class="pendente"><p>Apresentação detalhada e informações de localização em preparação.</p></div>
  </Secao>

  <!-- LINHAS DE PESQUISA E PROJETOS -->
  <Secao id="pesquisa" titulo="Linhas de pesquisa e projetos" etiqueta="O que investigamos">
    <div class="pendente"><p>Estamos preparando a apresentação das linhas de pesquisa e dos projetos do grupo.</p></div>
    <p class="link-projetos"><a href="https://github.com/neurocomp-nutes">Conheça nossos projetos no GitHub →</a></p>
  </Secao>

  <!-- PUBLICAÇÕES -->
  <Secao id="publicacoes" titulo="Produção científica" etiqueta="Artigos e trabalhos">
    <!-- Cada trabalho terá autores, ano, link e situação editorial explícita. -->
    <div class="pendente"><p>A lista de trabalhos será disponibilizada com identificação de artigos submetidos, preprints, aceitos e publicados.</p></div>
  </Secao>

  <!-- EQUIPE ATUAL -->
  <Secao id="equipe" titulo="Quem faz o NeuroComp" etiqueta="Equipe">
    <!-- Adicionar cartões apenas quando nomes, categorias e fotos forem fornecidos. -->
    {gruposMembros.map((grupo) => (
      <section class="grupo-membros" aria-labelledby={`grupo-${grupo.id}`}>
        <h3 class="titulo-grupo" id={`grupo-${grupo.id}`}>{grupo.titulo}</h3>
        <div class="grade-membros">
          {grupo.pessoas.map((membro) => <CartaoMembro membro={membro} />)}
        </div>
      </section>
    ))}
  </Secao>

  <!-- ALUMNI E MEMBROS NÃO HUMANOS -->
  <div class="grade">
    <Secao id="alumni" titulo="Alumni" etiqueta="Nossa trajetória">
      <p>Espaço dedicado a quem já fez parte do NeuroComp.</p>
      <div class="pendente"><p>Lista de antigos membros em preparação.</p></div>
    </Secao>
    <Secao id="nao-humanos" titulo="Membros não humanos" etiqueta="Além da pesquisa">
      <!-- O requisito informa o nome Marlboro; aguardamos foto e descrição. -->
      <h3>Marlboro</h3>
      <div class="pendente"><p>Foto e apresentação em breve.</p></div>
    </Secao>
  </div>
</LayoutPrincipal>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-carousel-viewport]').forEach((viewport) => {
    const name = viewport.dataset.carouselViewport;
    if (!name) return;

    const isHighlightCarousel = name === 'destaques';
    const controls = document.querySelectorAll<HTMLButtonElement>(`[data-carousel-control="${name}"]`);
    const indicators = document.querySelectorAll<HTMLButtonElement>(`[data-carousel-indicator="${name}"]`);
    const slides = viewport.children;
    let autoplayTimer: number | undefined;
    let autoplayAnimationFrame: number | undefined;
    let originalSnapType: string | undefined;

    const currentSlideIndex = () => {
      const viewportLeft = viewport.getBoundingClientRect().left;
      let closestIndex = 0;
      let closestDistance = Number.POSITIVE_INFINITY;

      Array.from(slides).forEach((slide, index) => {
        const distance = Math.abs(slide.getBoundingClientRect().left - viewportLeft);
        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      return closestIndex;
    };

    const goToSlide = (index: number, behavior: ScrollBehavior) => {
      if (autoplayAnimationFrame !== undefined) {
        window.cancelAnimationFrame(autoplayAnimationFrame);
        autoplayAnimationFrame = undefined;
      }
      if (originalSnapType !== undefined) {
        viewport.style.scrollSnapType = originalSnapType;
        originalSnapType = undefined;
      }

      const slide = slides[index];
      if (!slide) return;

      const left = viewport.scrollLeft
        + slide.getBoundingClientRect().left
        - viewport.getBoundingClientRect().left;
      viewport.scrollTo({ left, behavior });
    };

    const animateToSlide = (index: number) => {
      const slide = slides[index];
      if (!slide) return;

      if (autoplayAnimationFrame !== undefined) {
        window.cancelAnimationFrame(autoplayAnimationFrame);
      }
      if (originalSnapType !== undefined) {
        viewport.style.scrollSnapType = originalSnapType;
      }

      const start = viewport.scrollLeft;
      const target = start
        + slide.getBoundingClientRect().left
        - viewport.getBoundingClientRect().left;
      const distance = target - start;
      if (Math.abs(distance) < 1) return;

      const duration = 800;
      const startedAt = performance.now();
      originalSnapType = viewport.style.scrollSnapType;
      viewport.style.scrollSnapType = 'none';

      const animate = (now: number) => {
        const progress = Math.min((now - startedAt) / duration, 1);
        const easedProgress = 1 - (1 - progress) ** 3;
        viewport.scrollLeft = start + distance * easedProgress;

        if (progress < 1) {
          autoplayAnimationFrame = window.requestAnimationFrame(animate);
          return;
        }

        viewport.scrollLeft = target;
        viewport.style.scrollSnapType = originalSnapType ?? '';
        originalSnapType = undefined;
        autoplayAnimationFrame = undefined;
        scheduleAutoplay();
      };

      autoplayAnimationFrame = window.requestAnimationFrame(animate);
    };

    const scheduleAutoplay = () => {
      if (autoplayTimer !== undefined) {
        window.clearTimeout(autoplayTimer);
        autoplayTimer = undefined;
      }

      if (
        !isHighlightCarousel ||
        document.hidden ||
        slides.length < 2
      ) return;

      autoplayTimer = window.setTimeout(() => {
        const nextIndex = (currentSlideIndex() + 1) % slides.length;
        animateToSlide(nextIndex);
      }, 5000);
    };

    const updateState = () => {
      const maxScroll = viewport.scrollWidth - viewport.clientWidth;
      controls.forEach((control) => {
        if (isHighlightCarousel) {
          control.disabled = false;
          return;
        }
        const direction = Number(control.dataset.carouselDirection);
        control.disabled = direction < 0
          ? viewport.scrollLeft <= 1
          : viewport.scrollLeft >= maxScroll - 1;
      });

      if (indicators.length) {
        const activeIndex = currentSlideIndex();
        indicators.forEach((indicator, index) => {
          if (index === activeIndex) indicator.setAttribute('aria-current', 'true');
          else indicator.removeAttribute('aria-current');
        });
      }
    };

    controls.forEach((control) => {
      control.addEventListener('click', () => {
        const direction = Number(control.dataset.carouselDirection);
        if (isHighlightCarousel) {
          const nextIndex = (currentSlideIndex() + direction + slides.length) % slides.length;
          goToSlide(nextIndex, reducedMotion.matches ? 'instant' : 'smooth');
          scheduleAutoplay();
          return;
        }

        const step = name === 'noticias'
          ? (slides[0]?.getBoundingClientRect().width ?? viewport.clientWidth) + 20
          : viewport.clientWidth;
        viewport.scrollBy({ left: direction * step, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
      });
    });

    indicators.forEach((indicator) => {
      indicator.addEventListener('click', () => {
        const index = Number(indicator.dataset.carouselSlide);
        if (isHighlightCarousel) {
          goToSlide(index, reducedMotion.matches ? 'instant' : 'smooth');
        } else {
          viewport.scrollTo({
            left: viewport.clientWidth * index,
            behavior: reducedMotion.matches ? 'instant' : 'smooth',
          });
        }
        scheduleAutoplay();
      });
    });

    viewport.addEventListener('scroll', () => {
      updateState();
      scheduleAutoplay();
    }, { passive: true });
    window.addEventListener('resize', () => {
      updateState();
      scheduleAutoplay();
    });
    document.addEventListener('visibilitychange', scheduleAutoplay);
    reducedMotion.addEventListener('change', scheduleAutoplay);
    updateState();
    scheduleAutoplay();
  });
</script>

<style>
  /* <-------------------GRADE DA EQUIPE-------------------> */
  /* Neutraliza o estilo global de section nas subseções internas da equipe. */
  .grupo-membros { padding: 0; border: 0; border-radius: 0; background: transparent; }
  .grupo-membros + .grupo-membros { margin-top: 48px; }
  .titulo-grupo { margin: 0 0 24px; color: var(--texto-titulo); font-size: 1.4rem; }
  .titulo-grupo::after {
    content: '';
    display: block;
    width: 48px;
    height: 3px;
    margin-top: 12px;
    background: var(--verde);
    border-radius: 2px;
  }
  /* auto-fill reserva colunas para novos membros sem esticar um único cartão. */
  .grade-membros {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 24px;
    align-items: start;
  }

  /* <-------------------APRESENTAÇÃO-------------------> */
  .apresentacao {
    /* Centraliza o conjunto de logo, textos e botões. */
    display: grid;
    place-items: center;
    min-height: 620px;
    padding: 64px 24px;
    text-align: center;

    /* A primeira camada fica sobre a segunda: escurecimento sobre a foto. */
    background-image:
      linear-gradient(
        rgb(12 29 45 / 72%),
        rgb(12 29 45 / 82%)
      ),
      url('/imgs/fachadanutes.png');

    /* Preenche a capa sem deformar a fotografia. */
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  /* Limita a largura do conteúdo para facilitar a leitura. */
  .conteudo-capa {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    width: 100%;
    max-width: 760px;
  }

  /* A logo mantém suas proporções originais. */
  .apresentacao .logo-capa {
    width: clamp(160px, 22vw, 240px);
    height: auto;
  }

  .apresentacao h1 {
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    letter-spacing: -0.04em;
    color: #fff;
  }

  /* Mantém o texto legível sobre a fotografia nos dois temas. */
  .apresentacao .etiqueta {
    margin: 0;
    color: #cce8df;
  }

  .apresentacao .descricao-capa {
    max-width: 55ch;
    margin: 0;
    color: #f0f4f8;
    font-size: clamp(1rem, 2vw, 1.2rem);
  }

  .apresentacao .acoes {
    justify-content: center;
    margin-top: 12px;
  }

  .apresentacao .botao {
    background: #284e70;
    color: #fff;
    border: 1px solid #aec9df;
  }

  .apresentacao .botao:hover {
    background: #193b58;
  }

  .apresentacao .botao:focus-visible {
    outline-color: #fff;
  }

  .link-projetos { 
    margin-top: 24px; margin-bottom: 0; 
  }

  /* <-------------------NOTÍCIAS E CARROSSÉIS-------------------> */
  .destaques { margin: 8px 0 40px; }
  .cabecalho-carrossel { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 18px; }
  .destaques > .cabecalho-carrossel { flex-wrap: wrap; }
  .cabecalho-carrossel .etiqueta { margin: 0 0 6px; }
  .titulo-carrossel { margin: 0; color: var(--texto-titulo); font-size: 1.35rem; }
  .controles { display: flex; gap: 8px; flex-shrink: 0; }
  .controle {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid var(--borda);
    border-radius: 50%;
    background: var(--superficie);
    color: var(--azul);
    font-size: 1.4rem;
    cursor: pointer;
  }
  .controle:hover:not(:disabled) { border-color: var(--azul); background: var(--superficie-suave); }
  .controle:disabled { opacity: 0.4; cursor: not-allowed; }
  .viewport { display: flex; overflow-x: auto; overscroll-behavior-inline: contain; scrollbar-width: none; scroll-snap-type: x mandatory; }
  .viewport::-webkit-scrollbar { display: none; }
  .viewport:focus-visible { outline: 3px solid var(--azul); outline-offset: 4px; border-radius: 12px; }
  .viewport-destaques { border-radius: 14px; }
  .slide-destaque {
    position: relative;
    display: grid;
    flex: 0 0 100%;
    min-height: 300px;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    overflow: hidden;
    scroll-snap-align: start;
    background: var(--superficie-suave);
  }
  .slide-destaque > img { width: 100%; height: 100%; min-height: 300px; object-fit: cover; }
  .texto-destaque { padding: clamp(24px, 4vw, 44px); }
  .categoria { display: inline-block; color: var(--verde); font-size: 0.76rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .texto-destaque h4 { margin: 10px 0; color: var(--texto-titulo); font-size: clamp(1.45rem, 3vw, 2rem); line-height: 1.2; }
  .texto-destaque p, .corpo-noticia p { margin: 0; color: var(--texto-secundario); font-size: 0.98rem; }
  .indicadores { display: flex; justify-content: center; gap: 9px; margin-top: 16px; }
  .indicador { width: 9px; height: 9px; padding: 0; border: 0; border-radius: 50%; background: var(--borda); cursor: pointer; }
  .indicador[aria-current="true"] { width: 25px; border-radius: 8px; background: var(--verde); }
  .cabecalho-noticias { margin-bottom: 18px; }
  .viewport-noticias { gap: 20px; padding: 2px 2px 8px; }
  .cartao-noticia { flex: 0 0 calc((100% - 40px) / 3); min-width: 0; overflow: hidden; scroll-snap-align: start; border: 1px solid var(--borda); border-radius: 12px; background: var(--superficie); }
  .cartao-noticia > img { display: block; width: 100%; aspect-ratio: 8 / 5; object-fit: cover; }
  .corpo-noticia { display: flex; min-height: 210px; flex-direction: column; align-items: flex-start; padding: 20px; }
  .corpo-noticia h4 { margin: 8px 0; color: var(--texto-titulo); font-size: 1.1rem; line-height: 1.3; }
  .corpo-noticia p { font-size: 0.9rem; }
  .em-breve { margin-top: auto; padding-top: 16px; color: var(--verde); font-size: 0.8rem; font-weight: 700; }
  .dica-carrossel { margin: 12px 0 0; color: var(--texto-secundario); font-size: 0.82rem; text-align: right; }

  /* <-------------------TELAS PEQUENAS-------------------> */
  @media (max-width: 900px) {
    .cartao-noticia { flex-basis: calc((100% - 20px) / 2); }
  }
  @media (max-width: 700px) {
    /* Reduz os espaços da capa em telas pequenas. */
    .apresentacao { min-height: 520px; padding: 40px 20px;}
    .conteudo-capa {gap: 16px;}
    
    .slide-destaque { grid-template-columns: 1fr; }
    .slide-destaque > img { min-height: 0; aspect-ratio: 3 / 2; }
    .texto-destaque { padding: 22px; }
    .cartao-noticia { flex-basis: 86%; }
  }
  @media (max-width: 420px) {
    .cabecalho-carrossel { align-items: center; }
    .cartao-noticia { flex-basis: 100%; }
    .dica-carrossel { text-align: left; }
  }
</style>
