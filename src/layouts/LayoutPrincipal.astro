---
// <-------------------ESTRUTURA COMPARTILHADA------------------->
// Importar o CSS aqui aplica as regras de base a toda a página.
import '../styles/global.css';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
---
<!doctype html>
<html lang="pt-BR" data-theme="light">
  <head>
    <!-- CONFIGURAÇÕES DA PÁGINA -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Conheça o NeuroComp, grupo de pesquisa em Neurociência Computacional afiliado ao NUTES/UEPB." />
    <title>NeuroComp | NUTES/UEPB</title>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('neurocomp-theme');
        document.documentElement.dataset.theme = savedTheme === 'blue' ? 'blue' : 'light';
      } catch (error) {
        console.error('Não foi possível carregar a preferência de tema.', error);
        document.documentElement.dataset.theme = 'light';
      }
    </script>
    <script is:inline>
      document.documentElement.classList.add('preloader-ativo');

      const ocultarPreloader = () => {
        const preloader = document.querySelector('.preloader');
        if (!preloader || preloader.classList.contains('preloader-saindo')) return;
        preloader.classList.add('preloader-saindo');
        window.setTimeout(() => {
          preloader.remove();
          document.documentElement.classList.remove('preloader-ativo');
        }, 400);
      };

      const inicioPreloader = Date.now();
      const finalizarCarregamento = () => {
        window.setTimeout(ocultarPreloader, Math.max(0, 500 - (Date.now() - inicioPreloader)));
      };

      window.addEventListener('load', finalizarCarregamento, { once: true });
      window.setTimeout(ocultarPreloader, 8000);
      if (document.readyState === 'complete') finalizarCarregamento();
    </script>
    <!-- ÍCONE DA ABA DO NAVEGADOR -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=neurocomp-logo-1" />
  </head>
  <body>
    <div class="preloader" role="status" aria-live="polite" aria-label="Carregando o site NeuroComp">
      <img
        class="preloader-logo"
        src="/imgs/logos/oficial_brain_no_background.png"
        alt=""
        width="180"
        height="120"
        fetchpriority="high"
      />
      <span class="preloader-nome">NeuroComp</span>
      <span class="preloader-mensagem">Carregando...</span>
      <span class="preloader-progresso" aria-hidden="true"><span></span></span>
    </div>
    <a class="pular-conteudo" href="#conteudo">Pular para o conteúdo</a>
    <Cabecalho />
    <!-- CONTEÚDO PRINCIPAL -->
    <main id="conteudo" class="capa-ampla" tabindex="-1">
      <!-- O slot recebe as seções escritas no index.astro. -->
      <slot />
    </main>
    <Rodape />  
  </body>
</html>
